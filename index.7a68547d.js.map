    if (e.target === field) {
        var xPos = e.clientX - fieldRectX.left - spiderMid - field.clientLeft;
        var yPos = e.clientY - fieldRectY.top - spiderMid - field.clientTop;
        if (xPos < 0) xPos = 0;
        if (yPos < 0) yPos = 0;
        if (xPos > field.clientWidth - spider.offsetWidth) xPos = field.clientWidth - spider.offsetWidth;
        if (yPos > field.clientHeight - spider.offsetHeight) yPos = field.clientHeight - spider.offsetHeight;
        spider.style.left = xPos + "px";
        spider.style.top = yPos + "px";
    }
});

